<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="528.0" prefWidth="673.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.meneses.carlos.sudoku.controller.SudokuController">
   <top>
      <Label fx:id="titleLabel" contentDisplay="CENTER" prefHeight="86.0" prefWidth="221.0" styleClass="title-label" text="SUDOKU 6x6" textAlignment="CENTER" BorderPane.alignment="CENTER">
         <font>
            <Font size="15.0" />
         </font></Label>
   </top>
   <center>
      <StackPane fx:id="boardContainer" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
